{
  "name": "5kvideo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "start:media-worker": "node dist/mediaWorker.js",
    "db:migrate": "npm run build && node dist/postgres/migrate.js",
    "db:import-json": "npm run build && node dist/postgres/importJson.js",
    "db:import-runtime": "npm run build && node dist/postgres/importRuntime.js",
    "db:audit-runtime": "npm run build && node dist/postgres/auditRuntime.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3"
  }
}
