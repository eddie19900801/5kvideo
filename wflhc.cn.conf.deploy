server {
    listen 80;
    listen [::]:80;
    server_name 5knews.wflhc.cn wflhc.cn www.wflhc.cn *.wflhc.cn *.app.wflhc.cn;
    root /www/wwwroot/5knews-web-current;
    location ^~ /.well-known/acme-challenge/ { allow all; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 156.224.147.194:443 ssl;
    listen 156.224.147.220:443 ssl;
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name 5knews.wflhc.cn wflhc.cn www.wflhc.cn *.wflhc.cn *.app.wflhc.cn;
    root /www/wwwroot/5knews-web-current;
    index index.html;
    ssl_certificate /www/server/panel/vhost/cert/wflhc.cn/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/wflhc.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:WFLHCSSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location ^~ /vdo-api/ {
        proxy_set_header Host 897kg.cc;
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        rewrite ^/vdo-api/(.*)$ /vdo/api/$1 break;
        proxy_ssl_server_name on;
        proxy_ssl_name 897kg.cc;
        proxy_pass https://154.91.19.108;
    }
    location ^~ /nav-api/ {
        proxy_set_header Host 897kg.cc;
        rewrite ^/nav-api/(.*)$ /api/$1 break;
        proxy_ssl_server_name on;
        proxy_ssl_name 897kg.cc;
        proxy_pass https://154.91.19.108;
    }
    location ^~ /ads/api/ {
        proxy_set_header Host 897kg.cc;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_ssl_name 897kg.cc;
        proxy_pass https://154.91.19.108/ads/api/;
    }
    location ^~ /api/ {
        proxy_set_header Host 897kg.cc;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_ssl_name 897kg.cc;
        proxy_pass https://154.91.19.108/h5-api/;
    }
    location ^~ /uploads/ {
        proxy_set_header Host 897kg.cc;
        proxy_ssl_server_name on;
        proxy_ssl_name 897kg.cc;
        proxy_pass https://154.91.19.108/h5-uploads/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
    }
    location = /app/5kvideo-latest.apk {
        alias /www/wwwroot/5kvideo-app-download/5kvideo-latest.apk;
        default_type application/vnd.android.package-archive;
        add_header Content-Disposition "attachment; filename=5kvideo-latest.apk" always;
        add_header Cache-Control "public, max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location = /app/download { return 302 /app/download/; }
    location ^~ /app/ {
        alias /www/wwwroot/5kvideo-app-download/;
        types {
            image/png png;
            text/html html;
        }
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location ^~ /static-data/ {
        add_header Cache-Control "public, max-age=60, stale-while-revalidate=86400" always;
        try_files $uri =404;
    }
    location ^~ /assets/ { expires 30d; add_header Cache-Control "public, max-age=2592000, immutable" always; }
    location = /index.html { add_header Cache-Control "no-cache, no-store, must-revalidate" always; }
    location / { add_header Cache-Control "no-cache, no-store, must-revalidate" always; try_files $uri $uri/ /index.html; }
    access_log /www/wwwlogs/wflhc.cn.log;
    error_log /www/wwwlogs/wflhc.cn.error.log;
}
